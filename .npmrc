# This plugin is developed as a standalone package, but its @deepseek-ai/dsh-*
# dev dependencies are also published npm packages. Without this flag pnpm
# links any @deepseek-ai package it finds checked out in a neighbouring
# directory (e.g. the deepseek-harness workspace), which makes `typecheck` and
# `test` validate the wrong DSH release line.
link-workspace-packages=false

# Every @deepseek-ai/dsh-* package is a declared peer; installing peers
# automatically would add a second, unpinned copy beside the pinned dev copy.
auto-install-peers=false
